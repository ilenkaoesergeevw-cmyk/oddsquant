{
  "name": "e2e-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Single-user end-to-end encrypted text/file transfer between your own devices. The server only relays ciphertext.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node test/roundtrip.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
